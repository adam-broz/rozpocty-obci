---
import Base from '../../layouts/Base.astro';
import Search from '../../components/Search.astro';
import CategoryBars from '../../components/CategoryBars.astro';
import TrendChart from '../../components/TrendChart.astro';
import { getIndex, getMeta, getObec, duplicateNames } from '../../lib/data';
import { kc, money, num, pct, diffShort, groupLabel, plural } from '../../lib/format';
import { highlightSentence } from '../../lib/highlight';

export function getStaticPaths() {
  return getIndex().map((r) => ({ params: { id: r[0] } }));
}

const { id } = Astro.params as { id: string };
const o = getObec(id);
const meta = getMeta();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const dup = duplicateNames().has(o.name);
const title = dup && o.okres ? `${o.name} (okres ${o.okres})` : o.name;
const krajName = meta.kraje[o.kraj] ?? o.kraj;

const y = o.years.at(-1)!;
const pop = y.population ?? 0;
const pc = (x: number | null | undefined) => (x == null || !pop ? null : x / pop);
const g = y.group;
const med = (k: string) => g?.median[k] ?? null;
const compare = !!g && !o.isRegion;
const d = (val: number | null, m: number | null) => (val == null || !m ? null : val / m - 1);

const saldo = y.income.total != null && y.expense.total != null ? y.income.total - y.expense.total : null;
const investShare = y.expense.total ? y.expense.capital / y.expense.total : null;

const catRows = meta.categories
  .map((c) => ({
    id: c.id,
    name: c.name,
    description: c.description,
    value: pc(y.expense.categories[c.id]) ?? 0,
    median: compare ? med('cat_' + c.id) : null,
  }))
  .sort((a, b) => (a.id === 'ostatni' ? 1 : b.id === 'ostatni' ? -1 : b.value - a.value));

const incomeParts = [
  { key: 'tax', name: 'Daně', help: 'podíl na celostátních daních (DPH, daně z příjmů) a daň z nemovitostí', v: y.income.tax },
  { key: 'grants', name: 'Dotace a transfery', help: 'peníze od státu, kraje a z EU – na provoz i na investice', v: y.income.grants },
  { key: 'nontax', name: 'Nedaňové příjmy', help: 'nájmy, poplatky za služby, prodej dřeva, úroky', v: y.income.nontax },
  { key: 'capital', name: 'Prodej majetku', help: 'kapitálové příjmy – prodej pozemků, budov apod.', v: y.income.capital },
];
const incTotal = Math.max(1, incomeParts.reduce((s, p) => s + Math.max(0, p.v), 0));

const comparisons = [
  { name: 'Příjmy celkem', v: pc(y.income.total), m: med('income_total') },
  { name: 'z toho daňové příjmy', v: pc(y.income.tax), m: med('income_tax') },
  { name: 'Výdaje celkem', v: pc(y.expense.total), m: med('expense_total') },
  { name: 'z toho běžný provoz', v: pc(y.expense.current), m: med('expense_current') },
  { name: 'z toho investice', v: pc(y.expense.capital), m: med('expense_capital') },
];

const points = o.years.map((x) => ({ year: x.year, income: x.income.total, expense: x.expense.total, capital: x.expense.capital }));
const sentence = highlightSentence(o, meta);
const budgetRows = [
  { name: 'Příjmy', a: y.budget.incomeApproved, b: y.budget.incomeAmended, c: y.income.total },
  { name: 'Výdaje', a: y.budget.expenseApproved, b: y.budget.expenseAmended, c: y.expense.total },
];
const description = `Hospodaření obce ${o.name} v roce ${y.year}: příjmy ${money(y.income.total)}, výdaje ${money(y.expense.total)}. ${sentence ?? ''}`.trim();
---

<Base title={`${title} – rozpočet obce | Rozpočty obcí`} description={description} ogImage={`og/${o.id}.png`} canonicalPath={`obec/${o.id}/`}>
  <div class="top-search"><Search id="hledat-obec" /></div>

  <header class="obec-head">
    <p class="eyebrow muted">{o.isRegion ? 'Hlavní město' : o.statutory ? 'Statutární město' : 'Obec'} · {o.okres && o.okres !== 'Praha' ? `okres ${o.okres}, ` : ''}{krajName}</p>
    <h1>{o.name}</h1>
    <p class="muted">
      {num(pop)} obyvatel (k 1. 1. {y.year}) · hospodaření za rok <strong>{y.year}</strong> · IČO {o.ico}
    </p>
  </header>

  {sentence && (
    <p class="highlight">{sentence}</p>
  )}

  <section aria-labelledby="h-cisla">
    <h2 id="h-cisla" class="visually-hidden">Hlavní čísla</h2>
    <div class="kpis">
      <div class="card kpi">
        <h3>Příjmy</h3>
        <p class="big">{money(y.income.total)}</p>
        <p class="muted small">{kc(pc(y.income.total))} na obyvatele</p>
      </div>
      <div class="card kpi">
        <h3>Výdaje</h3>
        <p class="big">{money(y.expense.total)}</p>
        <p class="muted small">{kc(pc(y.expense.total))} na obyvatele</p>
      </div>
      <div class="card kpi">
        <h3>Investice</h3>
        <p class="big">{money(y.expense.capital)}</p>
        <p class="muted small">{investShare != null ? `${pct(investShare)} všech výdajů` : '–'}</p>
      </div>
      <div class="card kpi">
        <h3>{saldo != null && saldo < 0 ? 'Schodek' : 'Přebytek'}</h3>
        <p class="big">{money(saldo != null ? Math.abs(saldo) : null)}</p>
        <p class="muted small">{saldo != null && saldo < 0 ? 'utratila víc, než vybrala' : 'vybrala víc, než utratila'}</p>
      </div>
    </div>
  </section>

  <section aria-labelledby="h-kam" class="card">
    <h2 id="h-kam">Kam jdou peníze</h2>
    <p class="muted small">
      Výdaje v roce {y.year} v korunách na jednoho obyvatele, podle účelu.
      {compare && g && <>Svislá čárka je medián pro {groupLabel(g.band, g.scope, o.kraj)}.</>}
    </p>
    <CategoryBars rows={catRows} showMedian={compare} />
  </section>

  {compare && g && (
    <section aria-labelledby="h-srov">
      <h2 id="h-srov">Srovnání s podobnými obcemi</h2>
      <p>
        Porovnáváme s mediánem pro <strong>{groupLabel(g.band, g.scope, o.kraj)}</strong>
        ({g.n} {plural(g.n, 'obec', 'obce', 'obcí')}, rok {y.year}).
        {g.scope === 'cr' && <span class="muted"> V kraji je takových obcí méně než {meta.minGroupSize}, proto srovnáváme celostátně.</span>}
        {' '}Medián je hodnota „uprostřed“ – polovina obcí má víc, polovina méně.
      </p>
      <div class="table-scroll">
        <table class="table">
          <caption class="visually-hidden">Srovnání v Kč na obyvatele</caption>
          <thead><tr><th scope="col">Kč na obyvatele</th><th scope="col">{o.name}</th><th scope="col">Podobné obce</th><th scope="col">Rozdíl</th></tr></thead>
          <tbody>
            {comparisons.map((c) => (
              <tr class={c.name.startsWith('z toho') ? 'sub' : ''}>
                <th scope="row">{c.name}</th>
                <td>{kc(c.v)}</td>
                <td>{kc(c.m)}</td>
                <td>{diffShort(d(c.v, c.m))}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {o.isRegion && (
    <p class="note card">
      Praha je zároveň obcí i krajem – platí například střední školy nebo krajské silnice. Její výdaje proto
      nesrovnáváme s ostatními městy. Peníze, které Praha posílá městským částem (v roce {y.year}
      {' '}{money(y.districtTransfers ?? null)}), v jejích výdajích nejsou; utrácejí je městské části, které tu zatím
      nezobrazujeme.
    </p>
  )}
  {!o.isRegion && y.districtTransfers && (
    <p class="note card">
      Statutární město navíc v roce {y.year} poslalo {money(y.districtTransfers)} svým městským obvodům
      nebo částem. Tyto převody v jeho výdajích nejsou (utrácejí je obvody), stejně jako na portálu Monitor.
    </p>
  )}

  <section aria-labelledby="h-odkud" class="card">
    <h2 id="h-odkud">Odkud peníze přicházejí</h2>
    <div class="stack" aria-hidden="true">
      {incomeParts.map((p) => p.v > 0 && <span class={`seg ${p.key}`} style={`width:${((p.v / incTotal) * 100).toFixed(2)}%`}></span>)}
    </div>
    <ul class="inc-list">
      {incomeParts.map((p) => (
        <li>
          <span class={`dot ${p.key}`} aria-hidden="true"></span>
          <span><strong>{p.name}</strong> <span class="muted small">– {p.help}</span></span>
          <span class="amt">{money(p.v)} <span class="muted small">({pct(Math.max(0, p.v) / incTotal)})</span></span>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="h-vyvoj">
    <h2 id="h-vyvoj">Vývoj v čase</h2>
    <TrendChart points={points} />
  </section>

  <section aria-labelledby="h-plan">
    <h2 id="h-plan">Plán a skutečnost {y.year}</h2>
    <p class="muted small">
      Obec na začátku roku schválí rozpočet, během roku ho upravuje rozpočtovými opatřeními. Na webu všude
      ukazujeme skutečnost – co obec opravdu vybrala a utratila.
    </p>
    <div class="table-scroll">
      <table class="table">
        <thead><tr><th scope="col"></th><th scope="col">Schválený rozpočet</th><th scope="col">Po změnách</th><th scope="col">Skutečnost</th></tr></thead>
        <tbody>
          {budgetRows.map((r) => (
            <tr><th scope="row">{r.name}</th><td>{money(r.a)}</td><td>{money(r.b)}</td><td><strong>{money(r.c)}</strong></td></tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section aria-labelledby="h-zdroj" class="source">
    <h2 id="h-zdroj">Zdroj a data</h2>
    <p class="small">
      Zdroj dat: Ministerstvo financí ČR, Monitor státní pokladny (výkaz FIN 2-12 M); počet obyvatel Český
      statistický úřad. Čísla jsou upravená: sečtená do kategorií, bez převodů mezi vlastními účty obce
      (konsolidace) a přepočtená na obyvatele.
    </p>
    <ul class="small">
      {o.sourceUrl && <li><a href={o.sourceUrl}>{o.officialName} na portálu Monitor</a> (původní data)</li>}
      <li><a href={`${base}data/obce/${o.id}.json`}>Data této obce ve formátu JSON</a></li>
      <li><a href={`${base}o-projektu/`}>Jak čísla počítáme</a></li>
    </ul>
  </section>
</Base>

<style>
  .top-search { margin-bottom: 1.75rem; }
  .obec-head { margin-bottom: 1.25rem; }
  .eyebrow { margin: 0 0 .25rem; font-size: .95rem; }
  .highlight {
    font-size: 1.25rem; line-height: 1.4; font-weight: 600; margin: 0 0 1.75rem;
    padding: .9rem 1.1rem; border-left: 4px solid var(--accent); background: var(--accent-soft); border-radius: 0 var(--radius) var(--radius) 0;
  }
  .kpis { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
  @media (min-width: 720px) { .kpis { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .kpi { padding: 1rem; }
  .kpi h3 { font-size: .95rem; color: var(--muted); font-weight: 600; margin: 0 0 .2rem; }
  .big { font-size: clamp(1.25rem, 4.5vw, 1.6rem); font-weight: 700; margin: 0 0 .1rem; line-height: 1.2; }
  .kpi p:last-child { margin: 0; }
  section.card { padding: 1.25rem; }
  tr.sub th { font-weight: 400; padding-left: 1rem; color: var(--muted); }
  .note { font-size: .95rem; margin: -1rem 0 2.25rem; }
  .stack { display: flex; height: 18px; border-radius: 6px; overflow: hidden; margin: .5rem 0 1rem; gap: 2px; }
  .seg, .dot { background: var(--accent); }
  .tax { background: #0f5c8c; } .grants { background: #4f93c0; } .nontax { background: #9cc3df; } .capital { background: #5a5f66; }
  .inc-list { list-style: none; margin: 0; padding: 0; display: grid; gap: .6rem; }
  .inc-list li { display: grid; grid-template-columns: 14px 1fr auto; gap: .6rem; align-items: baseline; }
  .dot { width: 12px; height: 12px; border-radius: 3px; display: inline-block; }
  .amt { white-space: nowrap; text-align: right; }
  @media (max-width: 560px) {
    .inc-list li { grid-template-columns: 14px 1fr; }
    .amt { grid-column: 2; text-align: left; }
  }
  .source ul { padding-left: 1.1rem; }
</style>
