---
// Jen latinka + rozšířená latinka (čeština), ne cyrilice/řečtina.
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-ext-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-ext-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/source-sans-3/latin-ext-700.css';
import { getMeta } from '../lib/data';

interface Props {
  title: string;
  description: string;
  ogImage?: string; // cesta relativní k base, např. "og/533955.png"
  canonicalPath?: string;
}
const { title, description, ogImage, canonicalPath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const site = (Astro.site?.toString() ?? '').replace(/\/$/, '');
const abs = (p: string) => `${site}${base}${p}`;
const meta = getMeta();
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    {canonicalPath !== undefined && <link rel="canonical" href={abs(canonicalPath)} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content="Rozpočty obcí" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={abs(ogImage)} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <header class="site-header">
      <div class="wrap header-inner">
        <a class="brand" href={base}>
          <span class="brand-mark" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24"><rect x="3" y="12" width="4" height="9" rx="1" /><rect x="10" y="7" width="4" height="14" rx="1" /><rect x="17" y="3" width="4" height="18" rx="1" /></svg></span>
          Rozpočty obcí
        </a>
        <nav aria-label="Hlavní">
          <a href={`${base}#kraje`}>Kraje</a>
          <a href={`${base}o-projektu/`}>Jak to počítáme</a>
        </nav>
      </div>
    </header>
    <slot name="hero" />
    <main id="obsah" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-grid">
        <div>
          <p class="footer-brand">Rozpočty obcí</p>
          <p>Nezávislý open-source projekt. Nijak nesouvisí s Ministerstvem financí ani s Českým statistickým úřadem.</p>
        </div>
        <div>
          <p><strong>Zdroj dat: Ministerstvo financí ČR, Monitor státní pokladny; Český statistický úřad.</strong></p>
          <p>
            Data jsou upravená: sečtená do kategorií, bez převodů mezi vlastními účty obce a přepočtená na obyvatele.
            <a href={meta.sources.monitorLicense}>Podmínky užití dat Monitoru</a> ·
            <a href={`${base}o-projektu/`}>Metodika a licence</a>
          </p>
          <p class="muted">Aktualizováno {new Date(meta.generated).toLocaleDateString('cs-CZ')} · roky {meta.years[0]}–{meta.latestYear}</p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f6f5f1;
    --bg-soft: #eeede7;
    --surface: #ffffff;
    --ink: #1b1c1e;
    --muted: #575c63;
    --line: #dddbd3;
    --accent: #0f5c8c;
    --accent-soft: #e1edf5;
    --accent-ink: #0b4a72;
    --hero: #0f3b57;
    --hero-ink: #ffffff;
    --hero-muted: #c4d7e4;
    --median: #1b1c1e;
    --more: #9a4a0b;
    --less: #1f6a8f;
    --income: #0f5c8c;
    --expense: #d9895f;
    --capital: #8f3a12;
    --focus: #e0a100;
    --shadow: 0 1px 2px rgb(20 20 20 / .05), 0 4px 16px rgb(20 20 20 / .05);
    --radius: 12px;
    --font: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #131416;
      --bg-soft: #1f2124;
      --surface: #1b1d20;
      --ink: #ecebe7;
      --muted: #a9aeb5;
      --line: #33363b;
      --accent: #6fb3e0;
      --accent-soft: #1f3445;
      --accent-ink: #9fd0f2;
      --hero: #0d2a3d;
      --hero-ink: #ffffff;
      --hero-muted: #a9c3d6;
      --median: #ecebe7;
      --more: #f0b46b;
      --less: #8cc8ec;
      --income: #6fb3e0;
      --expense: #9a5a3c;
      --capital: #f2b38f;
      --shadow: none;
    }
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; scroll-padding-top: 72px; }
  @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font: 400 1.0625rem/1.55 var(--font);
    font-variant-numeric: tabular-nums;
  }
  a { color: var(--accent-ink); text-underline-offset: 2px; }
  a:hover { text-decoration-thickness: 2px; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 4px; }
  h1, h2, h3 { line-height: 1.2; text-wrap: balance; }
  h1 { font-size: clamp(2rem, 6vw, 2.9rem); font-weight: 700; margin: 0 0 .25rem; letter-spacing: -0.015em; }
  h2 { font-size: 1.45rem; font-weight: 700; margin: 0 0 .35rem; letter-spacing: -0.005em; }
  h3 { font-size: 1.05rem; font-weight: 600; margin: 0 0 .5rem; }
  p { margin: 0 0 1rem; }
  .wrap { max-width: 920px; margin: 0 auto; padding: 0 16px; }
  .muted { color: var(--muted); }
  .small { font-size: .92rem; }
  .skip { position: absolute; left: -999px; top: 0; background: var(--surface); padding: .5rem 1rem; z-index: 50; }
  .skip:focus { left: 8px; top: 8px; }
  .visually-hidden { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }

  .site-header { background: var(--surface); border-bottom: 1px solid var(--line); }
  .header-inner { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 58px; }
  .brand { display: inline-flex; gap: .55rem; align-items: center; font-weight: 700; color: var(--ink); text-decoration: none; font-size: 1.12rem; }
  .brand-mark { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; background: var(--accent); }
  .brand-mark svg { fill: #fff; }
  .site-header nav { display: flex; gap: 1.1rem; }
  .site-header nav a { color: var(--muted); font-size: .97rem; text-decoration: none; padding: .3rem 0; }
  .site-header nav a:hover { color: var(--ink); text-decoration: underline; }
  main.wrap { padding-top: 2.75rem; padding-bottom: 3.5rem; }
  @media (min-width: 720px) { main.wrap { padding-top: 3.25rem; } }

  .site-footer { background: var(--surface); border-top: 1px solid var(--line); padding: 2rem 0 2.5rem; font-size: .92rem; color: var(--muted); }
  .footer-grid { display: grid; gap: 1.25rem; }
  @media (min-width: 720px) { .footer-grid { grid-template-columns: 1fr 2fr; gap: 2.5rem; } }
  .footer-brand { font-weight: 700; color: var(--ink); margin-bottom: .35rem; }
  .site-footer strong { color: var(--ink); font-weight: 600; }
  .site-footer p { margin-bottom: .6rem; }

  .card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; box-shadow: var(--shadow); }
  section { margin: 0 0 2.75rem; }
  .section-head { margin-bottom: 1.1rem; }
  .section-head p { color: var(--muted); margin: 0; max-width: 44rem; }
  .table { width: 100%; border-collapse: collapse; font-size: .95rem; }
  .table th, .table td { text-align: right; padding: .55rem .5rem; border-bottom: 1px solid var(--line); }
  .table th:first-child, .table td:first-child { text-align: left; padding-left: 0; }
  .table thead th { font-weight: 600; color: var(--muted); font-size: .85rem; }
  .table-scroll { overflow-x: auto; }
  details > summary { cursor: pointer; color: var(--accent-ink); }
  details[open] > summary { margin-bottom: .5rem; }
</style>
