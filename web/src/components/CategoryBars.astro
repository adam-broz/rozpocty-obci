---
// „Kam jdou peníze“ – řádek na kategorii: ikona, název, popis, částka na
// obyvatele (pruh) a značka mediánu podobných obcí. Čistě HTML/CSS.
import Icon from './Icon.astro';
import { kc, money, pct, diffShort } from '../lib/format';

interface Row {
  id: string; name: string; description: string;
  value: number; total: number; share: number; median: number | null;
}
interface Props { rows: Row[]; showMedian: boolean }
const { rows, showMedian } = Astro.props;
const max = Math.max(1, ...rows.map((r) => Math.max(r.value, showMedian ? r.median ?? 0 : 0)));
const w = (x: number) => `${Math.max(0, (x / max) * 100).toFixed(2)}%`;
const tone = (d: number | null) => (d == null || Math.abs(d) < 0.05 ? 'same' : d > 0 ? 'more' : 'less');
---

<ul class="cats">
  {rows.map((r) => {
    const diff = showMedian && r.median ? r.value / r.median - 1 : null;
    return (
      <li>
        <span class={`ico ico-${r.id}`}><Icon name={r.id} size={20} /></span>
        <div class="body">
          <div class="head">
            <div class="title">
              <span class="name">{r.name}</span>
              <span class="desc">{r.description}</span>
            </div>
            <div class="nums">
              <span class="pc">{kc(r.value)}</span>
              <span class="tot">{money(r.total)} · {pct(r.share)}</span>
            </div>
          </div>
          <div class="track" aria-hidden="true">
            <div class="bar" style={`width:${w(r.value)}`}></div>
            {showMedian && r.median != null && <div class="med" style={`left:${w(r.median)}`}></div>}
          </div>
          {showMedian && r.median != null && (
            <p class="cmp">
              <span class={`chip ${tone(diff)}`}>{diff == null ? '–' : diffShort(diff)}</span>
              <span class="muted">podobné obce {kc(r.median)}</span>
            </p>
          )}
        </div>
      </li>
    );
  })}
</ul>

<style>
  .cats { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem; }
  li { display: grid; grid-template-columns: 40px 1fr; gap: .8rem; align-items: start; }
  .ico { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--accent-soft); color: var(--accent-ink); }
  .head { display: flex; justify-content: space-between; gap: .4rem 1rem; align-items: flex-start; }
  .title { display: flex; flex-direction: column; min-width: 0; }
  .name { font-weight: 700; }
  .desc { font-size: .88rem; color: var(--muted); line-height: 1.35; }
  .nums { display: flex; flex-direction: column; align-items: flex-end; text-align: right; white-space: nowrap; }
  .pc { font-weight: 700; font-size: 1.05rem; }
  .tot { font-size: .85rem; color: var(--muted); }
  .track { position: relative; height: 10px; margin-top: .45rem; background: var(--bg-soft); border-radius: 6px; }
  .bar { height: 100%; background: var(--accent); border-radius: 6px; min-width: 3px; }
  .med { position: absolute; top: -5px; bottom: -5px; width: 3px; margin-left: -1.5px; background: var(--median); border-radius: 2px; }
  .cmp { margin: .4rem 0 0; font-size: .88rem; display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; }
  .chip { display: inline-block; padding: .05rem .5rem; border-radius: 999px; font-weight: 700; font-size: .82rem; border: 1px solid currentColor; }
  .chip.more { color: var(--more); }
  .chip.less { color: var(--less); }
  .chip.same { color: var(--muted); }
  @media (max-width: 520px) {
    li { grid-template-columns: 32px 1fr; gap: .6rem; }
    .ico { width: 32px; height: 32px; border-radius: 8px; }
    .desc { display: none; }
  }
</style>
