---
// Vývoj příjmů a výdajů v čase – seskupené sloupce v SVG + tabulka s čísly.
import { money, moneyShort } from '../lib/format';

interface Point { year: number; income: number | null; expense: number | null; capital: number | null }
interface Props { points: Point[]; perCapita?: boolean }
const { points } = Astro.props;

const W = 640, H = 260, L = 56, R = 8, T = 12, B = 30;
const maxV = Math.max(1, ...points.flatMap((p) => [p.income ?? 0, p.expense ?? 0]));
// „hezké“ maximum osy
const mag = 10 ** Math.floor(Math.log10(maxV));
const step = [0.1, 0.2, 0.25, 0.5, 1, 2, 2.5, 5, 10].map((s) => s * mag).find((s) => maxV / s <= 5)!;
const top = Math.ceil(maxV / step) * step;
const ticks = Array.from({ length: Math.round(top / step) + 1 }, (_, i) => i * step);
const y = (v: number) => T + (H - T - B) * (1 - v / top);
const slot = (W - L - R) / points.length;
const bw = Math.min(34, slot * 0.32);
const label = points
  .map((p) => `${p.year}: příjmy ${money(p.income)}, výdaje ${money(p.expense)}`)
  .join('; ');
---

<figure class="trend">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Příjmy a výdaje podle let. ${label}`}>
    {ticks.map((t) => (
      <g>
        <line x1={L} x2={W - R} y1={y(t)} y2={y(t)} class="grid" />
        <text x={L - 8} y={y(t) + 4} class="tick" text-anchor="end">{moneyShort(t)}</text>
      </g>
    ))}
    {points.map((p, i) => {
      const cx = L + slot * (i + 0.5);
      return (
        <g>
          {p.income != null && <rect class="inc" x={cx - bw - 2} y={y(p.income)} width={bw} height={y(0) - y(p.income)} rx="2" />}
          {p.expense != null && <rect class="exp" x={cx + 2} y={y(p.expense)} width={bw} height={y(0) - y(p.expense)} rx="2" />}
          {p.capital != null && p.capital > 0 && (
            <rect class="cap" x={cx + 2} y={y(p.capital)} width={bw} height={y(0) - y(p.capital)} rx="2" />
          )}
          <text x={cx} y={H - 8} class="tick" text-anchor="middle">{p.year}</text>
        </g>
      );
    })}
  </svg>
  <figcaption class="legend small">
    <span><i class="k inc"></i>příjmy</span>
    <span><i class="k exp"></i>výdaje</span>
    <span><i class="k cap"></i>z toho investice</span>
  </figcaption>
</figure>

<details class="small">
  <summary>Zobrazit jako tabulku</summary>
  <div class="table-scroll">
    <table class="table">
      <thead><tr><th scope="col">Rok</th><th scope="col">Příjmy</th><th scope="col">Výdaje</th><th scope="col">Investice</th><th scope="col">Saldo</th></tr></thead>
      <tbody>
        {points.map((p) => (
          <tr>
            <th scope="row">{p.year}</th>
            <td>{money(p.income)}</td>
            <td>{money(p.expense)}</td>
            <td>{money(p.capital)}</td>
            <td>{p.income != null && p.expense != null ? money(p.income - p.expense) : '–'}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</details>

<style>
  .trend { margin: 0 0 .5rem; }
  svg { width: 100%; height: auto; display: block; overflow: visible; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .tick { fill: var(--muted); font-size: 12px; font-family: var(--font); }
  .inc { fill: var(--income); }
  .exp { fill: var(--expense); }
  .cap { fill: var(--capital); }
  .legend { display: flex; gap: 1.1rem; flex-wrap: wrap; color: var(--muted); margin-top: .5rem; }
  .k { display: inline-block; width: 12px; height: 12px; border-radius: 3px; margin-right: .35rem; vertical-align: -1px; }
  .k.inc { background: var(--income); }
  .k.exp { background: var(--expense); }
  .k.cap { background: var(--capital); }
</style>
