---
// Srovnání s podobnými obcemi: odchylka od mediánu jako pruh od středu
// (doleva = méně, doprava = víc). Pruh je oříznutý na ±50 % (aby byly vidět i menší rozdíly), číslo ne.
import { kc, diffShort } from '../lib/format';

interface Row { name: string; hint: string; value: number | null; median: number | null; sub?: boolean }
interface Props { rows: Row[]; obecName: string }
const { rows, obecName } = Astro.props;
const diff = (r: Row) => (r.value == null || !r.median ? null : r.value / r.median - 1);
const tone = (d: number | null) => (d == null || Math.abs(d) < 0.05 ? 'same' : d > 0 ? 'more' : 'less');
---

<div class="cmp-wrap">
  <p class="legend muted small" aria-hidden="true"><span>← méně</span><span>medián podobných obcí</span><span>víc →</span></p>
  <ul class="rows">
    {rows.map((r) => {
      const d = diff(r);
      const pct = d == null ? 0 : Math.max(-0.5, Math.min(0.5, d)) * 100; // pruh do ±50 %
      return (
        <li class:list={[{ sub: r.sub }]}>
          <div class="lbl">
            <span class="name">{r.name}</span>
            <span class="hint">{r.hint}</span>
          </div>
          <div class="viz" aria-hidden="true">
            <span class="mid"></span>
            {d != null && (
              <span class={`dev ${tone(d)}`} style={pct >= 0 ? `left:50%;width:${pct}%` : `left:${50 + pct}%;width:${-pct}%`}></span>
            )}
          </div>
          <div class="val">
            <strong class={tone(d)}>{diffShort(d)}</strong>
            <span class="muted">{kc(r.value)} vs. {kc(r.median)}</span>
          </div>
        </li>
      );
    })}
  </ul>
</div>

<details class="small">
  <summary>Zobrazit jako tabulku</summary>
  <div class="table-scroll">
    <table class="table">
      <caption class="visually-hidden">Srovnání v Kč na obyvatele</caption>
      <thead><tr><th scope="col">Kč na obyvatele</th><th scope="col">{obecName}</th><th scope="col">Podobné obce (medián)</th><th scope="col">Rozdíl</th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr><th scope="row">{r.name}</th><td>{kc(r.value)}</td><td>{kc(r.median)}</td><td>{diffShort(diff(r))}</td></tr>
        ))}
      </tbody>
    </table>
  </div>
</details>

<style>
  .cmp-wrap { margin-bottom: .75rem; }
  .legend { display: grid; grid-template-columns: minmax(9rem, 1.3fr) 1fr minmax(8.5rem, auto); gap: 1rem; margin: 0; }
  .legend span:nth-child(1) { grid-column: 2; grid-row: 1; justify-self: start; }
  .legend span:nth-child(2) { grid-column: 2; grid-row: 1; justify-self: center; }
  .legend span:nth-child(3) { grid-column: 2; grid-row: 1; justify-self: end; }
  .rows { list-style: none; margin: 0; padding: 0; }
  li { display: grid; grid-template-columns: minmax(9rem, 1.3fr) 1fr minmax(8.5rem, auto); gap: 1rem; align-items: center; padding: .65rem 0; border-bottom: 1px solid var(--line); }
  li.sub .name { font-weight: 600; }
  .lbl { display: flex; flex-direction: column; }
  .name { font-weight: 700; }
  .hint { font-size: .85rem; color: var(--muted); line-height: 1.3; }
  .viz { position: relative; height: 14px; background: var(--bg-soft); border-radius: 7px; }
  .mid { position: absolute; left: 50%; top: -4px; bottom: -4px; width: 2px; margin-left: -1px; background: var(--median); }
  .dev { position: absolute; top: 2px; bottom: 2px; border-radius: 5px; }
  .dev.more { background: var(--more); }
  .dev.less { background: var(--less); }
  .dev.same { background: var(--muted); }
  .val { display: flex; flex-direction: column; align-items: flex-end; text-align: right; font-size: .85rem; white-space: nowrap; }
  .val strong { font-size: 1.05rem; }
  strong.more { color: var(--more); }
  strong.less { color: var(--less); }
  strong.same { color: var(--muted); }
  @media (max-width: 600px) {
    .legend { grid-template-columns: 1fr; }
    .legend span:nth-child(n) { grid-column: 1; }
    li { grid-template-columns: 1fr auto; gap: .35rem 1rem; }
    .viz { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
